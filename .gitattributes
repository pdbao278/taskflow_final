# Normalize line endings to LF for all text files
* text=auto eol=lf

# Force LF for source files
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.env* text eol=lf

# Force LF for config files
*.mjs  text eol=lf
*.cjs  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf

# Binary — no conversion
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
